{
  "name": "beetalk",
  "productName": "BeeTalk",
  "version": "1.0.15",
  "description": "A modern XMPP chat client for Goonswarm Federation",
  "author": "JayJ Plaude <beetalk@gmail.com>",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/create-icons.js",
    "build": "npm run icons && electron-builder -mwl",
    "build:win": "npm run icons && electron-builder --win --publish never",
    "build:win:docker": "bash scripts/build-win-docker.sh",
    "build:mac": "npm run icons && electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "pack": "electron-builder --dir",
    "test": "npm run test:node && npm run test:electron",
    "test:node": "node --test \"test/node/**/*.test.js\"",
    "test:electron": "electron --no-sandbox test/electron/run.js"
  },
  "build": {
    "appId": "com.beetalk.app",
    "productName": "BeeTalk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "executableName": "BeeTalk",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "BeeTalk-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BeeTalk",
      "uninstallDisplayName": "BeeTalk",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150,
          "type": "file"
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon-linux.png",
      "category": "Network"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@xmpp/client": "^0.13.0",
    "electron-store": "^8.1.0"
  },
  "overrides": {
    "file-type": "^22.0.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  }
}
