<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define ProductVersion="1.0.2" ?>
  <?define ProductUpgradeCode="7c2b4e8a-9d3f-4f2a-8b1c-5d9e6f3a2b8c" ?>

  <Product Id="*"
           Name="BeeTalk"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="JayJ Plaude"
           UpgradeCode="$(var.ProductUpgradeCode)">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="A modern XMPP chat client" />

    <Media Id="1" Cabinet="BeeTalk.cab" EmbedCab="yes" />

    <!-- Upgrade strategy -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Close BeeTalk.exe if running during install/uninstall -->
    <util:CloseApplication Id="CloseBeeTalk"
                           Target="BeeTalk.exe"
                           RebootPrompt="no"
                           CloseMessage="yes" />

    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="BeeTalk" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="BeeTalk" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="BeeTalk" Level="1" Description="BeeTalk Chat Client">
      <ComponentRef Id="BeeTalkComponent" />
      <ComponentRef Id="ProgramMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Main application files (from dist folder) -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="BeeTalkComponent" Guid="8a2b4e7c-9d3f-4f2a-8b1c-5d9e6f3a2b8d">
        <!-- This is a placeholder - files will be populated by WiX heat.exe or manually -->
        <RegistryValue Root="HKCU"
                       Key="Software\BeeTalk"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Program menu shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ProgramMenuShortcut" Guid="9b3c5f8d-0e4a-5g3b-9c2d-6e0f7g4b3c9e">
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall BeeTalk"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\BeeTalk"
                       Name="ProgramMenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="0c4d6g9e-1f5b-6h4c-0d3e-7f1g8h5c4d0f">
        <RemoveFolder Id="DesktopFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\BeeTalk"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Icon reference -->
    <Icon Id="BeeTalkIcon" SourceFile="assets\icon.ico" />

    <!-- UI -->
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUIInstallDirectory" Value="INSTALLFOLDER" />

    <!-- Launch app after installation -->
    <CustomAction Id="LaunchApp"
                  Directory="INSTALLFOLDER"
                  ExeCommand="BeeTalk.exe"
                  Return="asyncNoWait"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize">NOT REMOVE AND NOT REINSTALL</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
